---
import { t, type Lang } from '../i18n/ui';
import { localizePath } from '../config/site';
interface Props { lang: Lang; }
const { lang } = Astro.props;
---

<section class="bottom-cta">
  <div class="container">
    <div>
      <h2>{t(lang, 'cta.title')}</h2>
      <p>{t(lang, 'cta.lead')}</p>
    </div>
    <div class="pills">
      <a class="btn btn--light" href={localizePath(lang, 'contact')}>
        {t(lang, 'cta.btn')} <svg class="icon"><use href="#i-arrow"></use></svg>
      </a>
      <a class="btn btn--outline" href="https://www.youthuni.com/" target="_blank" rel="noopener noreferrer">
        {t(lang, 'cta.youthBtn')} <svg class="icon"><use href="#i-arrow"></use></svg>
      </a>
    </div>
  </div>
</section>
