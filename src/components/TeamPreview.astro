---
import type { Lang } from '../i18n/ui';

interface TeamMember {
  id: string;
  name: string;
  role: string;
  photo: string;
  country: string;
  countryName: string;
  isDemo: boolean;
}
interface Props {
  lang: Lang;
  members: TeamMember[];
  notice: string;
  note: string;
  peopleHref: string;
}
const { members, notice, note, peopleHref } = Astro.props;

// Cross-region demo line-up (illustrative preview, not confirmed real teams).
const featuredCountries = ['Singapore', 'United Kingdom', 'Canada', 'Kenya', 'Australia', 'United Arab Emirates'];
const groups = featuredCountries
  .map((name) => {
    const list = members.filter((m) => m.country === name).slice(0, 3);
    return { country: name, countryName: list[0]?.countryName ?? name, members: list };
  })
  .filter((g) => g.members.length > 0);
---

<section class="team-preview" aria-label="Featured country teams">
  <div class="team-preview-banner">
    <span class="sample-flag">Preview</span>
    <p class="team-preview-notice">{notice}</p>
    <p class="team-preview-note">{note}</p>
  </div>
  <div class="team-grid">
    {groups.map((g) => (
      <article class="team-country">
        <a class="team-country-head" href={`${peopleHref}?country=${encodeURIComponent(g.country)}`}>
          <svg class="icon"><use href="#i-pin"></use></svg>
          <span>{g.countryName}</span>
          <svg class="icon team-country-arrow"><use href="#i-arrow"></use></svg>
        </a>
        <ul class="team-member-list">
          {g.members.map((m) => (
            <li class="team-member">
              <img class="team-avatar" src={m.photo} alt={m.name} loading="lazy" />
              <div class="team-meta">
                <span class="team-name">{m.name}</span>
                <span class="team-role">{m.role}</span>
              </div>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>
