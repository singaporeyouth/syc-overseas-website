---
import { t, pick, type Lang } from '../i18n/ui';
import type { Country } from '../content/config';
interface Props {
  countries: Country[];
  lang?: Lang;
  regions: { key: string; value: string; label: string }[];
  peopleHref: string;
  contactHref: string;
}
const { countries, lang = 'en', regions, peopleHref, contactHref } = Astro.props;
const L = (k: string) => t(lang, k);

// One coordinate set drives nodes, links and hit areas (same projection as WorldMap.astro).
const toX = (lng: number) => ((lng + 180) / 360) * 100;
const toY = (lat: number) => ((90 - lat) / 180) * 100;
const nodes = countries
  .filter((c) => typeof c.lat === 'number' && typeof c.lng === 'number')
  .map((c) => {
    const name = pick(c, 'name', lang);
    const region = pick(c, 'region', lang);
    const note = pick(c, 'note', lang);
    return {
      id: c.id,
      name,
      country: c.name,
      region,
      regionKey: c.region,
      note,
      x: toX(c.lng!),
      y: toY(c.lat!),
      search: `${name} ${c.name} ${region} ${c.region} ${note}`.toLowerCase(),
    };
  });
const hub = { x: toX(103.8), y: toY(1.35) };
const defaultIndex = Math.max(0, nodes.findIndex((n) => n.id === 'singapore'));
const initial = nodes[defaultIndex];
---

<div
  class="ne"
  data-ne-root
  data-ne-nodes={JSON.stringify(nodes)}
  data-ne-default={defaultIndex}
  data-ne-people-href={peopleHref}
  data-ne-contact-href={contactHref}
  data-ne-body={L('network.country.body')}
  data-ne-showing={L('filter.showing')}
  data-ne-results={L('filter.results')}
>
  <div class="ne-controls">
    <div class="ne-regions" role="group" aria-label={L('network.filter.all')}>
      {regions.map((r, i) => (
        <button type="button" class:list={['ne-chip', i === 0 && 'is-active']} data-ne-region={r.value} aria-pressed={i === 0 ? 'true' : 'false'}>{r.label}</button>
      ))}
    </div>
    <label class="ne-search">
      <svg class="icon" aria-hidden="true"><use href="#i-compass"></use></svg>
      <input type="search" data-ne-search placeholder={L('people.search.placeholder')} aria-label={L('people.search.placeholder')} autocomplete="off" />
    </label>
  </div>

  <div class="ne-toolbar">
    <button type="button" class="ne-toggle" data-ne-toggle-map aria-expanded="false" aria-controls="ne-map">
      <svg class="icon" aria-hidden="true"><use href="#i-globe"></use></svg><span>{L('network.map.title')}</span>
    </button>
    <button type="button" class="ne-clear" data-ne-clear hidden>{L('people.search.clear')}</button>
  </div>

  <div class="ne-layout">
    <div class="ne-map-col" id="ne-map">
      <div class="ne-canvas">
        <img class="ne-world" src="/assets/world-light.svg" alt="" loading="lazy" />
        <svg class="ne-links" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          {nodes.map((n) => <line class="ne-link" x1={hub.x} y1={hub.y} x2={n.x} y2={n.y} />)}
        </svg>
        {nodes.map((n, i) => (
          <button
            type="button"
            class:list={['ne-node', i === defaultIndex && 'is-active']}
            style={`left:${n.x}%;top:${n.y}%`}
            data-ne-node={i}
            aria-label={n.name}
            title={n.name}
            aria-pressed={i === defaultIndex ? 'true' : 'false'}
          ></button>
        ))}
        <span class="ne-hub" style={`left:${hub.x}%;top:${hub.y}%`} aria-hidden="true"></span>
      </div>
      <div class="ne-map-note"><svg class="icon" aria-hidden="true"><use href="#i-shield"></use></svg> {L('network.map.note')}</div>
    </div>

    <aside class="ne-side">
      <p class="ne-count" data-ne-count aria-live="polite">{L('filter.showing')} {nodes.length} {L('filter.results')}</p>
      <div class="ne-list" data-ne-list>
        {nodes.map((n, i) => (
          <button
            type="button"
            class:list={['ne-item', i === defaultIndex && 'is-active']}
            data-ne-item={i}
            data-region={n.regionKey}
            data-search={n.search}
            aria-pressed={i === defaultIndex ? 'true' : 'false'}
          >
            <span class="ne-item-name">{n.name}</span>
            <span class="ne-item-region">{n.region}</span>
          </button>
        ))}
      </div>
      <div class="ne-empty" data-ne-empty hidden>
        <svg class="icon" aria-hidden="true"><use href="#i-globe"></use></svg>
        <p>{L('network.empty')}</p>
      </div>
      <div class="ne-detail" data-ne-detail>
        <span class="ne-detail-tag" data-ne-d-region>{initial?.region}</span>
        <h3 data-ne-d-name>{initial?.name}</h3>
        <p class="ne-detail-body" data-ne-d-body>{L('network.country.body').replace('{Country Name}', initial?.name ?? '')}</p>
        <p class="ne-detail-note" data-ne-d-note>{initial?.note}</p>
        <div class="ne-detail-actions">
          <a class="btn btn--primary" data-ne-team href={`${peopleHref}?country=${encodeURIComponent(initial?.country ?? '')}`}>
            {L('network.teamBtn')} <svg class="icon" aria-hidden="true"><use href="#i-arrow"></use></svg>
          </a>
          <a class="btn btn--outline" data-ne-collab href={`${contactHref}?topic=partnership&country=${encodeURIComponent(initial?.country ?? '')}`}>
            {L('network.collabBtn')} <svg class="icon" aria-hidden="true"><use href="#i-arrow"></use></svg>
          </a>
        </div>
      </div>
    </aside>
  </div>
</div>

<style>
  .ne{display:flex;flex-direction:column;gap:18px}
  .ne-controls{display:flex;flex-wrap:wrap;gap:14px;align-items:center;justify-content:space-between}
  .ne-regions{display:flex;flex-wrap:wrap;gap:8px}
  .ne-chip{border:1px solid var(--line2,#d8e2ea);background:#fff;color:var(--navy,#12324D);border-radius:999px;padding:8px 14px;font-size:.82rem;font-weight:700;cursor:pointer;transition:all .18s ease}
  .ne-chip:hover{border-color:var(--accent,#24A6B5)}
  .ne-chip.is-active{background:var(--navy,#12324D);border-color:var(--navy,#12324D);color:#fff}
  .ne-search{display:flex;align-items:center;gap:8px;flex:1 1 240px;max-width:320px;border:1px solid var(--line2,#d8e2ea);border-radius:12px;background:#fff;padding:8px 12px}
  .ne-search .icon{width:18px;height:18px;color:var(--accent,#24A6B5);flex:none}
  .ne-search input{border:0;outline:0;background:transparent;width:100%;font:inherit;color:var(--navy,#12324D)}
  .ne-toolbar{display:none;justify-content:space-between;align-items:center}
  .ne-toolbar button{border:1px solid var(--line2,#d8e2ea);background:#fff;border-radius:10px;padding:8px 12px;font-size:.82rem;font-weight:700;color:var(--navy,#12324D);cursor:pointer;display:inline-flex;align-items:center;gap:7px}
  .ne-toolbar .icon{width:16px;height:16px;color:var(--accent,#24A6B5)}
  .ne-layout{display:grid;grid-template-columns:minmax(0,65fr) minmax(0,35fr);gap:22px;align-items:start}
  .ne-map-col{min-width:0}
  .ne-canvas{position:relative;width:100%;aspect-ratio:1200/525;background:#eef4f9;border:1px solid var(--line2,#d8e2ea);border-radius:16px;overflow:hidden}
  .ne-world,.ne-links{position:absolute;inset:0;width:100%;height:100%}
  .ne-world{object-fit:fill}
  .ne-link{stroke:var(--action,#1769C2);stroke-width:.18;stroke-opacity:.42}
  .ne-node{position:absolute;transform:translate(-50%,-50%);width:11px;height:11px;border-radius:50%;border:2px solid #fff;background:var(--action,#1769C2);box-shadow:0 1px 4px rgba(16,43,76,.4);padding:0;cursor:pointer;transition:transform .18s ease,box-shadow .18s ease}
  .ne-node:hover{transform:translate(-50%,-50%) scale(1.35)}
  .ne-node.is-active{transform:translate(-50%,-50%) scale(1.5);background:var(--accent,#24A6B5);box-shadow:0 0 0 4px rgba(36,166,181,.32),0 2px 6px rgba(16,43,76,.4)}
  .ne-hub{position:absolute;transform:translate(-50%,-50%);width:14px;height:14px;border-radius:2px;background:var(--navy,#12324D);border:2px solid #fff;box-shadow:0 1px 5px rgba(16,43,76,.5);pointer-events:none}
  .ne-map-note{display:flex;align-items:center;gap:8px;margin-top:10px;color:#5b6b78;font-size:.78rem;font-weight:600}
  .ne-map-note .icon{width:16px;height:16px;color:var(--accent,#24A6B5)}
  .ne-side{display:flex;flex-direction:column;gap:10px;min-width:0}
  .ne-count{margin:0;color:#5b6b78;font-size:.8rem;font-weight:700}
  .ne-list{display:flex;flex-direction:column;gap:4px;max-height:290px;overflow-y:auto;border:1px solid var(--line2,#d8e2ea);border-radius:14px;padding:6px;background:rgba(255,255,255,.7)}
  .ne-item{position:relative;display:flex;flex-direction:column;align-items:flex-start;gap:1px;width:100%;text-align:left;border:1px solid transparent;border-radius:9px;background:transparent;padding:8px 10px 8px 18px;cursor:pointer;transition:background .16s ease,border-color .16s ease}
  .ne-item:before{content:"";position:absolute;left:6px;top:50%;transform:translateY(-50%);width:5px;height:5px;border-radius:50%;background:var(--line3,#c9d6e0)}
  .ne-item:hover{background:rgba(36,166,181,.08)}
  .ne-item.is-active{background:rgba(36,166,181,.12);border-color:rgba(36,166,181,.45)}
  .ne-item.is-active:before{background:var(--accent,#24A6B5);height:60%;border-radius:3px}
  .ne-item-name{font-size:.9rem;font-weight:700;color:var(--navy,#12324D)}
  .ne-item-region{font-size:.72rem;color:#6b7d8b}
  .ne-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;min-height:160px;border:1px dashed var(--line3,#c9d6e0);border-radius:14px;color:#5b6b78;text-align:center;padding:16px}
  .ne-empty .icon{width:34px;height:34px;opacity:.5}
  .ne-empty p{margin:0;font-size:.84rem;font-weight:700}
  .ne-detail{display:flex;flex-direction:column;gap:8px;border:1px solid var(--line2,#d8e2ea);border-radius:14px;background:#fff;padding:16px}
  .ne-detail-tag{align-self:flex-start;font-size:.7rem;font-weight:800;letter-spacing:.04em;text-transform:uppercase;color:var(--accent,#24A6B5);background:rgba(36,166,181,.1);border-radius:999px;padding:3px 10px}
  .ne-detail h3{margin:0;font-size:1.15rem;color:var(--navy,#12324D)}
  .ne-detail-body{margin:0;font-size:.82rem;line-height:1.6;color:#44586a}
  .ne-detail-note{margin:0;font-size:.78rem;line-height:1.55;color:#6b7d8b}
  .ne-detail-actions{display:flex;flex-direction:column;gap:8px;margin-top:4px}
  .ne-detail-actions .btn{justify-content:center;font-size:.82rem;padding:10px 14px}
  @media(max-width:900px){
    .ne-layout{grid-template-columns:1fr}
    .ne-toolbar{display:flex}
    .ne-map-col{display:none;order:2}
    .ne.map-open .ne-map-col{display:block}
    .ne-side{order:1}
    .ne-list{max-height:240px}
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ne-root]').forEach((root) => {
    const nodes: Array<{ id: string; name: string; country: string; region: string; regionKey: string; note: string; search: string }> = JSON.parse(root.dataset.neNodes || '[]');
    const items = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-ne-item]'));
    const nodeEls = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-ne-node]'));
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-ne-region]'));
    const search = root.querySelector<HTMLInputElement>('[data-ne-search]');
    const count = root.querySelector<HTMLElement>('[data-ne-count]');
    const empty = root.querySelector<HTMLElement>('[data-ne-empty]');
    const dRegion = root.querySelector<HTMLElement>('[data-ne-d-region]');
    const dName = root.querySelector<HTMLElement>('[data-ne-d-name]');
    const dBody = root.querySelector<HTMLElement>('[data-ne-d-body]');
    const dNote = root.querySelector<HTMLElement>('[data-ne-d-note]');
    const dTeam = root.querySelector<HTMLAnchorElement>('[data-ne-team]');
    const dCollab = root.querySelector<HTMLAnchorElement>('[data-ne-collab]');
    const clearBtn = root.querySelector<HTMLButtonElement>('[data-ne-clear]');
    const toggleBtn = root.querySelector<HTMLButtonElement>('[data-ne-toggle-map]');
    const peopleHref = root.dataset.nePeopleHref || '';
    const contactHref = root.dataset.neContactHref || '';
    const bodyTpl = root.dataset.neBody || '';
    const showingPrefix = root.dataset.neShowing || 'Showing';
    const resultsSuffix = root.dataset.neResults || 'results';
    const defaultIndex = Number(root.dataset.neDefault || 0);
    let activeRegion = 'all';
    let selected = -1;

    const query = () => (search?.value || '').trim().toLowerCase();
    const isVisible = (i: number) => {
      const n = nodes[i];
      if (!n) return false;
      if (activeRegion !== 'all' && n.regionKey !== activeRegion) return false;
      const q = query();
      if (q && !n.search.includes(q)) return false;
      return true;
    };

    const setUrl = (country?: string) => {
      try {
        const url = new URL(window.location.href);
        if (country) url.searchParams.set('country', country);
        else url.searchParams.delete('country');
        history.replaceState(history.state, '', url.toString());
      } catch (_) { /* file:// or restricted context */ }
    };
    const urlCountry = () => {
      try { return new URL(window.location.href).searchParams.get('country'); } catch (_) { return null; }
    };

    const select = (i: number, writeUrl = true) => {
      const n = nodes[i];
      if (!n) return;
      selected = i;
      nodeEls.forEach((el, k) => {
        const on = k === i;
        el.classList.toggle('is-active', on);
        el.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      items.forEach((el, k) => {
        const on = k === i;
        el.classList.toggle('is-active', on);
        el.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      if (dRegion) dRegion.textContent = n.region;
      if (dName) dName.textContent = n.name;
      if (dBody) dBody.textContent = bodyTpl.replace('{Country Name}', n.name);
      if (dNote) dNote.textContent = n.note;
      if (dTeam) dTeam.href = `${peopleHref}?country=${encodeURIComponent(n.country)}`;
      if (dCollab) dCollab.href = `${contactHref}?topic=partnership&country=${encodeURIComponent(n.country)}`;
      if (writeUrl) setUrl(n.country);
      const activeItem = items[i];
      if (activeItem && typeof activeItem.scrollIntoView === 'function') activeItem.scrollIntoView({ block: 'nearest' });
    };

    const apply = () => {
      let shown = 0;
      items.forEach((el, i) => {
        const v = isVisible(i);
        el.hidden = !v;
        if (v) shown++;
      });
      nodeEls.forEach((el, i) => { el.hidden = !isVisible(i); });
      if (count) count.textContent = `${showingPrefix} ${shown} ${resultsSuffix}`;
      if (empty) empty.hidden = shown > 0;
      if (clearBtn) clearBtn.hidden = activeRegion === 'all' && !query();
      if (selected < 0 || !isVisible(selected)) {
        const first = nodes.findIndex((_, i) => isVisible(i));
        if (first >= 0) select(first, false);
      }
    };

    chips.forEach((btn) => btn.addEventListener('click', () => {
      activeRegion = btn.dataset.neRegion || 'all';
      chips.forEach((c) => {
        const on = c === btn;
        c.classList.toggle('is-active', on);
        c.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      apply();
    }));
    search?.addEventListener('input', apply);
    items.forEach((el, i) => el.addEventListener('click', () => select(i)));
    nodeEls.forEach((el, i) => el.addEventListener('click', () => select(i)));
    clearBtn?.addEventListener('click', () => {
      activeRegion = 'all';
      if (search) search.value = '';
      chips.forEach((c, i) => {
        const on = i === 0;
        c.classList.toggle('is-active', on);
        c.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      apply();
      setUrl(nodes[defaultIndex]?.country);
    });
    toggleBtn?.addEventListener('click', () => {
      const open = root.classList.toggle('map-open');
      toggleBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });

    const locate = (write = false) => {
      const c = urlCountry();
      if (!c) return false;
      const i = nodes.findIndex((n) => n.country === c || n.id === c || n.name === c);
      if (i >= 0 && isVisible(i)) { select(i, write); return true; }
      return false;
    };
    window.addEventListener('popstate', () => { locate(false); });

    apply();
    if (!locate(false)) select(defaultIndex, false);
  });
</script>
