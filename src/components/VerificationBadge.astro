---
import { t, type Lang } from '../i18n/ui';
interface Props { lang: Lang; text?: string; }
const { lang, text } = Astro.props;
const label = text ?? t(lang, 'common.sample');
---
<span class="verify-badge" title="Placeholder — must be verified before publication">
  <svg class="icon" aria-hidden="true"><use href="#i-shield"></use></svg>
  {label}
</span>
