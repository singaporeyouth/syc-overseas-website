---
import { t, type Lang } from '../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
---

<section class="section section--ice">
  <div class="container narrow">
    <div class="card" style="padding:clamp(24px,4vw,48px)">
      <div class="kicker">{t(lang, 'contact.form.title')}</div>
      <h2 style="margin-bottom:8px">{t(lang, 'contact.form.title')}</h2>
      <div class="callout" role="note">
        <svg class="icon"><use href="#i-shield"></use></svg>
        <span>{t(lang, 'contact.form.draftBody')}</span>
      </div>
      <form id="enquiryForm" class="contact-form" novalidate>
        <div class="form-row">
          <label class="field">{t(lang, 'contact.form.name')}<input name="name" type="text" autocomplete="name" /></label>
          <label class="field">{t(lang, 'contact.form.email')}<input name="email" type="email" autocomplete="email" /></label>
        </div>
        <div class="form-row">
          <label class="field">{t(lang, 'contact.form.org')}<input name="organisation" type="text" autocomplete="organization" /></label>
          <label class="field">{t(lang, 'contact.form.topic')}
            <select name="topic">
              <option value="partnership">Partnership</option>
              <option value="programme">Programme</option>
              <option value="media">Media</option>
              <option value="other">Other</option>
            </select>
          </label>
        </div>
        <label class="field">{t(lang, 'contact.form.message')}<textarea name="message" rows="6"></textarea></label>
        <div class="actions">
          <button type="submit" class="btn btn--primary">{t(lang, 'contact.form.submit')} <svg class="icon"><use href="#i-arrow"></use></svg></button>
        </div>
      </form>
      <div id="draftOutput" class="callout callout--success" role="status" hidden>
        <strong>{t(lang, 'contact.form.draftTitle')}</strong>
        <pre></pre>
      </div>
    </div>
  </div>
</section>
