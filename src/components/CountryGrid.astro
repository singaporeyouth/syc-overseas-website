---
import { t, pick, type Lang } from '../i18n/ui';
import type { Country } from '../content/config';
interface Props { lang: Lang; countries: Country[]; scopeId?: string; limit?: number; }
const { lang, countries, scopeId = 'countryGrid', limit } = Astro.props;
const list = limit ? countries.slice(0, limit) : countries;
---

<div class="card-grid" data-filter-scope={scopeId}>
  {list.map((c) => (
    <article class="card card--image" data-filter-value={c.region}>
      <div class="card-media">
        <img src={c.photo} alt={`${pick(c, 'name', lang)} city view`} loading="lazy" />
        <span class="card-tag">{pick(c, 'region', lang)}</span>
      </div>
      <div class="card-body">
        <h3>{pick(c, 'name', lang)}</h3>
        <p>{pick(c, 'note', lang) || t(lang, 'common.sampleData')}</p>
      </div>
    </article>
  ))}
</div>
