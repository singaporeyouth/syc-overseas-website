---
import type { Lang } from '../i18n/ui';
import type { Partner } from '../content/config';
interface Props { lang: Lang; partners: Partner[]; }
const { lang, partners } = Astro.props;
---

<div class="card-grid">
  {partners.map((p) => (
    <article class="card">
      <div class="card-body">
        <span class="feature-icon"><svg class="icon"><use href="#i-building"></use></svg></span>
        <h3>{lang === "zh" && p.nameZh ? p.nameZh : p.name}</h3>
        <div class="person-role">{p.type}</div>
        <p>{lang === "zh" && p.descriptionZh ? p.descriptionZh : p.description}</p>
      </div>
    </article>
  ))}
</div>
