---
import { pick, type Lang } from '../i18n/ui';
import type { CaseStudy } from '../content/config';
interface Props { lang: Lang; cases: CaseStudy[]; }
const { lang, cases } = Astro.props;
---

<div class="card-grid">
  {cases.map((c) => (
    <article class="card card--image">
      <div class="card-media">
        <img src={c.image} alt={pick(c, 'title', lang)} loading="lazy" />
        <span class="card-tag">{pick(c, 'category', lang)}</span>
      </div>
      <div class="card-body">
        <h3>{pick(c, 'title', lang)}</h3>
        <p>{pick(c, 'summary', lang)}</p>
      </div>
    </article>
  ))}
</div>
