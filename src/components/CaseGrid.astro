---
import type { Lang } from '../i18n/ui';
import type { CaseStudy } from '../content/config';
interface Props { lang: Lang; cases: CaseStudy[]; }
const { lang, cases } = Astro.props;
---

<div class="card-grid">
  {cases.map((c) => (
    <article class="card card--image">
      <div class="card-media">
        <img src={c.image} alt={lang === "zh" && c.titleZh ? c.titleZh : c.title} loading="lazy" />
        <span class="card-tag">{c.category}</span>
      </div>
      <div class="card-body">
        <h3>{lang === 'zh' && c.titleZh ? c.titleZh : c.title}</h3>
        <p>{lang === "zh" && c.summaryZh ? c.summaryZh : c.summary}</p>
      </div>
    </article>
  ))}
</div>
