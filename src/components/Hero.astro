---
import { t, type Lang } from '../i18n/ui';
interface PanelItem { value: string; label: string; note?: string; }
interface Props {
  lang: Lang;
  eyebrow: string;
  titleHtml: string;
  lead: string;
  image?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
  panel?: PanelItem[];
  panelTitle1?: string;
  panelTitle2?: string;
  compact?: boolean;
}
const {
  lang, eyebrow, titleHtml, lead,
  image = '/assets/hero-people.jpg',
  primary, secondary, panel, panelTitle1, panelTitle2, compact = false,
} = Astro.props;
---

<section class:list={['hero', compact && 'hero--compact']}>
  <div class="container hero-grid">
    <div class="hero-copy">
      <div class="eyebrow"><svg class="icon"><use href="#i-spark"></use></svg> {eyebrow}</div>
      <h1 set:html={titleHtml} />
      <p class="lead">{lead}</p>
      <div class="actions">
        {primary && <a class="btn btn--primary" href={primary.href}>{primary.label} <svg class="icon"><use href="#i-arrow"></use></svg></a>}
        {secondary && <a class="btn btn--outline" href={secondary.href}>{secondary.label}</a>}
      </div>
    </div>
    <div class="hero-visual">
      <div class="hero-visual-inner">
        <img src={image} alt="" loading="eager" decoding="async" />
        {panel && panel.length > 0 && (
          <div class="float-panel">
            <div class="float-panel-head">
              <svg class="icon"><use href="#i-globe"></use></svg>
              <span>{panelTitle1 ?? t(lang, 'home.hero.panelTitle1')}</span>
              <svg class="icon"><use href="#i-ai"></use></svg>
              <span>{panelTitle2 ?? t(lang, 'home.hero.panelTitle2')}</span>
            </div>
            <div class="float-panel-grid">
              {panel.map((p) => (
                <div class="float-panel-item">
                  <div class="float-panel-value">{p.value}</div>
                  <div class="float-panel-label">{p.label}</div>
                  {p.note && <div class="float-panel-note">{p.note}</div>}
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</section>
