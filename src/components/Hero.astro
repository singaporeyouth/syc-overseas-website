---
import { t, type Lang } from '../i18n/ui';
interface Props {
  lang: Lang;
  eyebrow: string;
  titleHtml: string;
  lead: string;
  image?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
  compact?: boolean;
  tags?: string[];
  photoTag?: string;
  youthLink?: { label: string; href: string };
}
const {
  lang, eyebrow, titleHtml, lead,
  image = '/assets/hero-people.jpg',
  primary, secondary, compact = false, tags, photoTag, youthLink,
} = Astro.props;
---

<section class:list={['hero', compact && 'hero--compact']}>
  <div class="container hero-grid">
    <div class="hero-copy">
      <div class="eyebrow"><svg class="icon"><use href="#i-spark"></use></svg> {eyebrow}</div>
      <h1 set:html={titleHtml} />
      <p class="lead">{lead}</p>
      <div class="actions">
        {primary && <a class="btn btn--primary" href={primary.href}>{primary.label} <svg class="icon"><use href="#i-arrow"></use></svg></a>}
        {secondary && <a class="btn btn--outline" href={secondary.href}>{secondary.label}</a>}
      </div>
      {youthLink && (
        <a class="hero-textlink" href={youthLink.href}>
          {youthLink.label} <svg class="icon"><use href="#i-arrow"></use></svg>
        </a>
      )}
      {tags && tags.length > 0 && (
        <div class="hero-tags" aria-label={t(lang, 'home.hero.tagLabel') ?? 'Capabilities'}>
          {tags.map((tag) => <span class="pill">{tag}</span>)}
        </div>
      )}
    </div>
    <div class="hero-visual">
      <div class="hero-visual-inner">
        <img src={image} alt="" loading="eager" decoding="async" />
        {photoTag && <span class="hero-photo-tag"><svg class="icon"><use href="#i-globe"></use></svg> {photoTag}</span>}
      </div>
    </div>
  </div>
</section>
