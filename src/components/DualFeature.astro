---
import WorldMap from './WorldMap.astro';
import { t, type Lang } from '../i18n/ui';
import { localizePath } from '../config/site';
import type { Country } from '../content/config';
interface Props { lang: Lang; countries: Country[]; }
const { lang, countries } = Astro.props;
const features = [
  { icon: 'compass', title: t(lang, 'home.dual.ai1'), sub: t(lang, 'home.dual.ai1sub') },
  { icon: 'route', title: t(lang, 'home.dual.ai2'), sub: t(lang, 'home.dual.ai2sub') },
  { icon: 'spark', title: t(lang, 'home.dual.ai3'), sub: t(lang, 'home.dual.ai3sub') },
];
const networkHref = localizePath(lang, 'network');
const aiHref = localizePath(lang, 'ai');
---

<div class="dual-grid">
  <article class="card map-card">
    <div class="card-media map-card-media">
      <WorldMap countries={countries} theme="light" note={t(lang, 'home.dual.mapNote')} />
    </div>
    <div class="card-body">
      <div class="kicker">{t(lang, 'home.dual.networkKicker')}</div>
      <h2>{t(lang, 'home.dual.networkTitle')}</h2>
      <p>{t(lang, 'home.dual.networkLead')}</p>
      <a class="link-arrow" href={networkHref}>{t(lang, 'home.dual.exploreNetwork')} <svg class="icon"><use href="#i-arrow"></use></svg></a>
    </div>
  </article>

  <article class="card ai-feature">
    <div class="ai-feature-visual">
      <img src="/assets/ai-chip.jpg" alt="AI and youth innovation" loading="lazy" />
      <div class="ai-orbit orbit-1"></div>
      <div class="ai-orbit orbit-2"></div>
      <div class="ai-orbit orbit-3"></div>
      <span class="ai-core"><svg class="icon"><use href="#i-ai"></use></svg></span>
    </div>
    <div class="card-body">
      <div class="kicker">{t(lang, 'home.dual.aiKicker')}</div>
      <h2>{t(lang, 'home.dual.aiTitle')}</h2>
      <p>{t(lang, 'home.dual.aiLead')}</p>
      <div class="feature-list">
        {features.map((f) => (
          <div class="feature-item">
            <span class="feature-icon"><svg class="icon"><use href={`#i-${f.icon}`}></use></svg></span>
            <div><div class="feature-title">{f.title}</div><div class="feature-sub">{f.sub}</div></div>
          </div>
        ))}
      </div>
      <a class="link-arrow" href={aiHref}>{t(lang, 'home.dual.exploreAI')} <svg class="icon"><use href="#i-arrow"></use></svg></a>
    </div>
  </article>
</div>
