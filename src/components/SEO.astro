---
import { SITE, localizePath } from '../config/site';
import { LANGS, LANG_META, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  pageId: string;
  image?: string;
  type?: 'website' | 'organization';
}
const { lang, title, description, pageId, image = '/assets/hero-people.jpg', type = 'website' } = Astro.props;
const is404 = pageId === '404';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const pagePath = pageId === 'index' ? '' : pageId;
const localeUrls = LANGS.map((l) => ({ lang: l, url: new URL(localizePath(l, pagePath), Astro.site).href }));
const enUrl = localeUrls.find((x) => x.lang === 'en')!.url;
const orgJson = JSON.stringify(SITE.orgJsonLd);
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#0b214e" />
{!is404 && <link rel="canonical" href={canonical} />}
<meta name="robots" content={is404 ? 'noindex, nofollow' : 'index, follow'} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={LANG_META[lang].og} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Language alternates -->
{!is404 && <>
{localeUrls.map((x) => <link rel="alternate" hreflang={x.lang} href={x.url} />)}
<link rel="alternate" hreflang="x-default" href={enUrl} />
</>}

<!-- Organization structured data (contact info intentionally omitted until verified) -->
<script type="application/ld+json" is:inline set:html={orgJson} />
