---
import { SITE, pages, pageHref } from '../config/site';
import { t, LANGS, LANG_META, type Lang } from '../i18n/ui';
interface Props { lang: Lang; currentPage: string; }
const { lang, currentPage } = Astro.props;

// P1 navigation: five primary sections, ordered per spec.
const primaryIds = ['impact', 'network', 'ai', 'partnerships'];
const primary = primaryIds
  .map((id) => pages.find((p) => p.id === id))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
const aboutItem = pages.find((p) => p.id === 'about');
const aboutSub = pages.filter((p) => p.id === 'people');
const current = LANG_META[lang];
---

<header class="site-header">
  <div class="nav-wrap">
    <a class="brand" href={pageHref(lang, 'index')} aria-label={`${SITE.name} — home`}>
      <img class="brand-logo" src={SITE.logo} alt={`${SITE.name} official logo`} />
      <div>
        <div class="brand-title">Singapore Youth<br />Community <span style="font-size:.84em">(SYC)</span></div>
        <div class="brand-sub">{t(lang, 'brand.sub')}</div>
        <div class="brand-slogan">{t(lang, 'brand.slogan')}</div>
      </div>
    </a>

    <nav class="nav-links" id="navLinks" aria-label={t(lang, 'nav.menu')}>
      <!-- About SYC (link) with a chevron that reveals Our People -->
      <span class="nav-about-group">
        {aboutItem && (
          <a href={pageHref(lang, aboutItem.id)} aria-current={currentPage === 'about' ? 'page' : undefined}>{t(lang, aboutItem.navKey)}</a>
        )}
        <div class="nav-more" id="moreDropdown">
          <button type="button" class="nav-more-btn nav-about-btn" id="moreToggle" aria-expanded="false" aria-haspopup="true" aria-controls="moreMenu" aria-label={t(lang, 'nav.people')}>
            <svg class="icon chev"><use href="#i-arrow"></use></svg>
          </button>
          <div class="nav-more-menu" id="moreMenu" role="menu">
            {aboutSub.map((item) => (
              <a role="menuitem" href={pageHref(lang, item.id)} aria-current={currentPage === item.id ? 'page' : undefined}>{t(lang, item.navKey)}</a>
            ))}
          </div>
        </div>
      </span>

      {primary.map((item) => (
        <a
          href={pageHref(lang, item.id)}
          aria-current={currentPage === item.id ? 'page' : undefined}
        >{t(lang, item.navKey)}</a>
      ))}

      <a class="btn btn--primary nav-cta" href={pageHref(lang, 'contact')}>
        {t(lang, 'common.partnerWithUs')} <svg class="icon"><use href="#i-arrow"></use></svg>
      </a>
    </nav>

    <!-- Single language button + dropdown -->
    <div class="lang-dd" id="langDropdown">
      <button type="button" class="lang-dd-btn" id="langToggle" aria-label={t(lang, 'nav.switchLang')} aria-haspopup="true" aria-expanded="false" aria-controls="langMenu">
        <svg class="icon"><use href="#i-globe"></use></svg>
        <span>{current.label}</span>
        <svg class="icon chev"><use href="#i-arrow"></use></svg>
      </button>
      <div class="lang-dd-menu" id="langMenu" role="menu" aria-label={t(lang, 'nav.switchLang')}>
        {LANGS.map((l) => (
          <a role="menuitem" href={pageHref(l, currentPage)} class={lang === l ? 'active' : ''} hreflang={l} lang={l} aria-current={lang === l ? 'true' : undefined} title={LANG_META[l].native}>
            <span class="lang-native">{LANG_META[l].native}</span>
            <span class="lang-label">{LANG_META[l].label}</span>
            <svg class="icon"><use href="#i-check"></use></svg>
          </a>
        ))}
      </div>
    </div>

    <button type="button" class="menu-toggle" id="menuToggle" aria-controls="navLinks" aria-expanded="false" aria-label={t(lang, 'nav.menu')}>
      <svg class="icon"><use href="#i-menu"></use></svg>
    </button>
  </div>
</header>
