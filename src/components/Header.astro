---
import { SITE, pages, pageHref } from '../config/site';
import { t, LANGS, LANG_META, type Lang } from '../i18n/ui';
interface Props { lang: Lang; currentPage: string; }
const { lang, currentPage } = Astro.props;
const nav = [
  ...pages,
  { id: 'contact', path: 'contact', navKey: 'nav.contact' },
];
---

<header class="site-header">
  <div class="nav-wrap">
    <a class="brand" href={pageHref(lang, 'index')} aria-label={`${SITE.name} — home`}>
      <img class="brand-logo" src={SITE.logo} alt={`${SITE.name} official logo`} />
      <div>
        <div class="brand-title">Singapore Youth<br />Community <span style="font-size:.84em">(SYC)</span></div>
        <div class="brand-sub">{t(lang, 'brand.sub')}</div>
      </div>
    </a>

    <nav class="nav-links" id="navLinks" aria-label="Main navigation">
      {nav.map((item) => (
        <a
          href={pageHref(lang, item.id)}
          aria-current={currentPage === item.id ? 'page' : undefined}
        >{t(lang, item.navKey)}</a>
      ))}
      <a class="btn btn--primary nav-cta" href={pageHref(lang, 'contact')}>
        {t(lang, 'nav.cta')} <svg class="icon"><use href="#i-arrow"></use></svg>
      </a>
      <!-- Mobile-only language switcher, shown inside the expanded menu -->
      <div class="lang-switch lang-switch--menu" aria-label={t(lang, 'nav.switchLang')} role="group">
        {LANGS.map((l) => (
          <a href={pageHref(l, currentPage)} class={lang === l ? 'active' : ''} hreflang={l} lang={l} aria-current={lang === l ? 'true' : undefined} title={LANG_META[l].native}>{LANG_META[l].label}</a>
        ))}
      </div>
    </nav>

    <button type="button" class="btn btn--outline btn--small" id="openSearch" aria-label={t(lang, 'nav.search')} style="padding:10px;margin-left:2px">
      <svg class="icon"><use href="#i-search"></use></svg>
    </button>

    <div class="lang-switch lang-switch--inline" aria-label={t(lang, 'nav.switchLang')} role="group">
      {LANGS.map((l, i) => (
        <>
          {i > 0 && <span aria-hidden="true">/</span>}
          <a href={pageHref(l, currentPage)} class={lang === l ? 'active' : ''} hreflang={l} lang={l} aria-current={lang === l ? 'true' : undefined} title={LANG_META[l].native}>{LANG_META[l].label}</a>
        </>
      ))}
    </div>

    <button type="button" class="menu-toggle" id="menuToggle" aria-controls="navLinks" aria-expanded="false" aria-label={t(lang, 'nav.menu')}>
      <svg class="icon"><use href="#i-menu"></use></svg>
    </button>
  </div>
</header>
