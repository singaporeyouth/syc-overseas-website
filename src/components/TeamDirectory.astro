---
import { t, pick, type Lang } from '../i18n/ui';
import { pageHref } from '../config/site';
import type { Person, Country } from '../content/config';

interface Props {
  lang: Lang;
  people: Person[];
  countries: Country[];
}
const { lang, people, countries } = Astro.props;
const L = (k: string) => t(lang, k);
const contactHref = pageHref(lang, 'contact');

// Optional small flag per country (name matches countries.json `name` / people.json `country`).
const FLAGS: Record<string, string> = {
  Singapore: '🇸🇬', Japan: '🇯🇵', China: '🇨🇳', 'South Korea': '🇰🇷', India: '🇮🇳',
  Indonesia: '🇮🇩', Malaysia: '🇲🇾', Thailand: '🇹🇭', Vietnam: '🇻🇳', Philippines: '🇵🇭',
  'United Kingdom': '🇬🇧', Germany: '🇩🇪', France: '🇫🇷', Italy: '🇮🇹', Spain: '🇪🇸',
  Netherlands: '🇳🇱', Sweden: '🇸🇪', Switzerland: '🇨🇭', Poland: '🇵🇱',
  'United States': '🇺🇸', Canada: '🇨🇦', Brazil: '🇧🇷', Mexico: '🇲🇽', Argentina: '🇦🇷',
  Chile: '🇨🇱', Colombia: '🇨🇴', Kenya: '🇰🇪', Nigeria: '🇳🇬', 'South Africa': '🇿🇦',
  Egypt: '🇪🇬', Ghana: '🇬🇭', Australia: '🇦🇺', 'New Zealand': '🇳🇿',
  'United Arab Emirates': '🇦🇪', 'Saudi Arabia': '🇸🇦', Israel: '🇮🇱',
};

const NAME_FIELDS = ['name', 'nameZh', 'nameFr', 'nameRu', 'nameJa', 'nameKo'];
const REGION_FIELDS = ['region', 'regionZh', 'regionFr', 'regionRu', 'regionJa', 'regionKo'];
const ROLE_FIELDS = ['role', 'roleZh', 'roleFr', 'roleRu', 'roleJa', 'roleKo'];

interface Member {
  name: string;
  role: string;
  avatar: string;
  avatarAlt: string;
  initials: string;
}
interface Group {
  countryEn: string;
  countryName: string;
  regionEn: string;
  regionName: string;
  flag: string;
  members: Member[];
  search: string;
  index: number;
}

const countryByEn = new Map<string, Country>(countries.map((c) => [c.name, c]));
const groups: Group[] = [];
const indexByCountry = new Map<string, number>();

for (const p of people) {
  let idx = indexByCountry.get(p.country);
  if (idx === undefined) {
    idx = groups.length;
    indexByCountry.set(p.country, idx);
    const c = countryByEn.get(p.country);
    groups.push({
      countryEn: p.country,
      countryName: c ? pick(c, 'name', lang) : p.country,
      regionEn: c?.region ?? p.region,
      regionName: c ? pick(c, 'region', lang) : p.region,
      flag: FLAGS[p.country] ?? '',
      members: [],
      search: '',
      index: idx,
    });
  }
  const g = groups[idx];
  const parts: string[] = [p.country, p.name, p.region];
  const c = countryByEn.get(p.country);
  if (c) {
    for (const f of NAME_FIELDS) { const v = (c as Record<string, any>)[f]; if (v) parts.push(v); }
    for (const f of REGION_FIELDS) { const v = (c as Record<string, any>)[f]; if (v) parts.push(v); }
  }
  for (const f of ROLE_FIELDS) { const v = (p as Record<string, any>)[f]; if (v) parts.push(v); }
  g.search = (g.search ? g.search + ' ' : '') + parts.join(' ');
  g.members.push({
    name: p.name,
    role: pick(p, 'role', lang),
    // 阶段2A-3：头像取每人独立 SVG 字段（avatar），保留 photo 兼容与姓名缩写回退。
    avatar: (p as any).avatar || p.photo || '',
    avatarAlt: (p as any).avatarAlt || p.name,
    initials: p.name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase(),
  });
}

const regions = [
  { value: 'all', label: L('network.filter.all') },
  { value: 'Asia', label: L('network.filter.asia') },
  { value: 'Europe', label: L('network.filter.europe') },
  { value: 'Americas', label: L('network.filter.americas') },
  { value: 'Africa', label: L('network.filter.africa') },
  { value: 'Oceania', label: L('network.filter.oceania') },
  { value: 'Middle East', label: L('network.filter.middleeast') },
];
const INITIAL = 12;
---

<div
  class="td-root"
  data-td-root
  data-count-initial={L('people.search.showing')}
  data-count-filtered={L('people.search.teams')}
>
  <div class="td-toolbar">
    <div class="searchbox td-search">
      <svg class="icon"><use href="#i-search"></use></svg>
      <input type="search" data-td-input placeholder={L('people.search.placeholder')} aria-label={L('people.search.placeholder')} autocomplete="off" />
    </div>
    <div class="filter-bar td-region-bar" data-td-region-bar role="group" aria-label={L('people.search.placeholder')}>
      {regions.map((r, i) => (
        <button type="button" class:list={['filter-btn', i === 0 && 'active']} data-td-region-btn={r.value}>{r.label}</button>
      ))}
    </div>
    <button type="button" class="btn btn--outline td-clear" data-td-clear hidden>{L('people.search.clear')}</button>
  </div>

  <!-- 计数文案逐字：初始 people.search.showing / 筛选 people.search.teams，见组件脚本 -->
  <p class="filter-meta td-meta" data-td-count aria-live="polite">{L('people.search.showing')}</p>

  <div class="team-grid" data-td-grid>
    {groups.map((g) => (
      <article
        class="team-country td-card"
        data-td-card
        data-td-region={g.regionEn}
        data-td-index={g.index}
        data-td-members={g.members.length}
        data-td-search={g.search.toLowerCase()}
        hidden={g.index >= INITIAL}
      >
        <div class="team-country-head td-country-head">
          {g.flag && <span class="td-flag" aria-hidden="true">{g.flag}</span>}
          <span class="td-country-name">{g.countryName}</span>
          <span class="td-region-name">{g.regionName}</span>
        </div>
        <ul class="team-member-list">
          {g.members.map((m) => (
            <li class="team-member">
              {m.avatar
                ? <img class="team-avatar" src={m.avatar} alt={m.avatarAlt} data-initials={m.initials} loading="lazy" />
                : <span class="team-avatar team-avatar--initials" aria-hidden="true">{m.initials}</span>}
              <div class="team-meta">
                <span class="team-name">{m.name}</span>
                <span class="team-role">{m.role}</span>
              </div>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>

  <div class="empty-results td-empty" data-td-empty hidden>
    <svg class="icon"><use href="#i-people"></use></svg>
    <p>{L('people.search.emptyTitle')}</p>
    <p class="td-empty-note">{L('people.search.emptyDesc')}</p>
    <button type="button" class="btn btn--outline" data-td-empty-clear>{L('people.search.clear')}</button>
  </div>

  <div class="td-loadmore-wrap" data-td-loadmore-wrap>
    <button type="button" class="btn btn--outline" data-td-loadmore>{L('people.loadmore.label')}</button>
  </div>

  <aside class="td-contact contact-channel-card" role="note">
    <div class="contact-channel-icon"><svg class="icon"><use href="#i-people"></use></svg></div>
    <div class="contact-channel-body">
      <span class="panel-label">{L('people.hero.eyebrow')}</span>
      <strong>{L('people.contact.title')}</strong>
      <a class="contact-channel-value" href={`${contactHref}?topic=country-team`}>{L('people.interest.cta')}</a>
      <p class="contact-channel-note">{L('people.contact.desc')}</p>
    </div>
  </aside>
</div>

<script>
  // 阶段2A-3：计数文案逐字渲染（初始 / 筛选二态）。
  // main.ts 仍负责筛选、地区、展开、清除、URL 预填等交互；本脚本只按可见状态切换计数文案，
  // 从而保留已修好的功能，同时让计数显示为 ui.ts 的逐字整句。
  document.querySelectorAll<HTMLElement>('[data-td-root]').forEach((root) => {
    const grid = root.querySelector<HTMLElement>('[data-td-grid]');
    const count = root.querySelector<HTMLElement>('[data-td-count]');
    if (!grid || !count) return;
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-td-card]'));
    const input = root.querySelector<HTMLInputElement>('[data-td-input]');
    const regionBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-td-region-btn]'));
    const tplInitial = root.getAttribute('data-count-initial') || '';
    const tplFiltered = root.getAttribute('data-count-filtered') || '';

    // 头像加载失败 → 姓名缩写回退，绝不显示破图。
    root.querySelectorAll<HTMLImageElement>('img.team-avatar').forEach((img) => {
      img.addEventListener('error', () => {
        const span = document.createElement('span');
        span.className = 'team-avatar team-avatar--initials';
        span.setAttribute('aria-hidden', 'true');
        span.textContent = img.getAttribute('data-initials') || '';
        img.replaceWith(span);
      });
    });

    const update = () => {
      const q = (input?.value || '').trim().toLowerCase();
      const activeBtn = regionBtns.find((b) => b.classList.contains('active'));
      const region = activeBtn?.getAttribute('data-td-region-btn') || 'all';
      const filtering = Boolean(q) || region !== 'all';
      count.textContent = filtering ? tplFiltered : tplInitial;
    };

    input?.addEventListener('input', update);
    regionBtns.forEach((b) => b.addEventListener('click', () => window.setTimeout(update, 0)));
    root.querySelectorAll('[data-td-clear], [data-td-empty-clear], [data-td-loadmore]').forEach((el) =>
      el.addEventListener('click', () => window.setTimeout(update, 0))
    );
    if (typeof MutationObserver !== 'undefined') {
      const mo = new MutationObserver(update);
      mo.observe(grid, { attributes: true, attributeFilter: ['hidden'], subtree: true });
    }
    update();

    // 国家链接进入后：在 main.ts 应用筛选后滚动定位到首个匹配卡片。
    try {
      const preset = new URLSearchParams(window.location.search).get('country');
      if (preset) {
        window.setTimeout(() => {
          const first = cards.find((c) => !c.hidden);
          if (first) first.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 140);
      }
    } catch (_) { /* noop */ }
  });
</script>

<style>
  /* 阶段2A-3：卡片尺寸/间距/字号按 V3 2.3 校准（scope 样式覆盖全局 app.css） */
  .team-grid { gap: 18px; }
  .team-country { padding: 20px; border-radius: 16px; }
  .td-country-head .td-country-name { font-size: 19px; white-space: normal; overflow: visible; text-overflow: clip; }
  .team-avatar { width: 40px; height: 40px; }
  .team-name { font-size: 16px; }
  .team-role { font-size: 14px; line-height: 1.45; white-space: normal; }
  .team-meta { min-width: 0; }
  .team-member { align-items: flex-start; }
  /* 搜索占满可用宽度；地区标签可换行 */
  .td-toolbar .searchbox { flex: 1 1 320px; margin-left: 0; }
  .td-toolbar .filter-bar { flex: 0 1 auto; flex-wrap: wrap; }
  .td-meta { margin-top: 8px; margin-bottom: 2px; }
  @media (max-width: 600px) {
    .td-toolbar .searchbox { flex: 1 1 100%; }
    .td-toolbar .filter-bar { flex: 1 1 100%; }
  }
</style>
