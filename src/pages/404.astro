---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/ui';
---

<BaseLayout lang="en" pageId="404" title="Page Not Found — SYC" description="The page you are looking for does not exist.">
  <section class="section">
    <div class="container narrow" style="text-align:center;padding:clamp(60px,12vw,140px) 0">
      <div class="kicker">404</div>
      <h1>{t('en', 'notfound.title')}</h1>
      <p class="lead">{t('en', 'notfound.body')}</p>
      <div class="actions" style="justify-content:center;margin-top:24px">
        <a class="btn btn--primary" href="/">{t('en', 'notfound.back')} <svg class="icon"><use href="#i-arrow"></use></svg></a>
      </div>
    </div>
  </section>
</BaseLayout>
