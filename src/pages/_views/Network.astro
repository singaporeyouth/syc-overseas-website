---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatsBar from '../../components/StatsBar.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import NetworkExplorer from '../../components/NetworkExplorer.astro';
import { t, pick, type Lang } from '../../i18n/ui';
import { pageHref } from '../../config/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (k: string) => t(lang, k);
const [countryEntries, metrics] = await Promise.all([
  getCollection('countries'), getCollection('metrics'),
]);
const countries = countryEntries.map((c) => c.data);
const stats = metrics.slice(0, 2).map((m) => ({
  display: m.data.display,
  label: pick(m.data, 'label', lang),
  icon: m.data.icon,
}));
const peopleHref = pageHref(lang, 'people');
const contactHref = pageHref(lang, 'contact');
const regions = [
  { key: 'all', value: 'all', label: L('network.filter.all') },
  { key: 'asia', value: 'Asia', label: L('network.filter.asia') },
  { key: 'europe', value: 'Europe', label: L('network.filter.europe') },
  { key: 'americas', value: 'Americas', label: L('network.filter.americas') },
  { key: 'africa', value: 'Africa', label: L('network.filter.africa') },
  { key: 'oceania', value: 'Oceania', label: L('network.filter.oceania') },
  { key: 'middleeast', value: 'Middle East', label: L('network.filter.middleeast') },
  { key: 'global', value: 'Global', label: L('network.filter.global') },
];
const roles = [
  { icon: 'globe', title: L('network.role1.title'), body: L('network.role1.body') },
  { icon: 'handshake', title: L('network.role2.title'), body: L('network.role2.body') },
  { icon: 'building', title: L('network.role3.title'), body: L('network.role3.body') },
];
// Render the V3 two-line H1 from the existing ui.ts key (no new hard-coded copy).
const titleParts = L('network.hero.title').split(/(?<=\.)\s+/);
---

<BaseLayout lang={lang} pageId="network" title={L('seo.network.title')} description={L('seo.network.desc')}>
  <!-- Compact header: no city hero image; first screen text directly visible -->
  <header class="net-head">
    <div class="container net-head-inner">
      <div>
        <p class="eyebrow">{L('network.hero.eyebrow')}</p>
        <h1 class="net-title">{titleParts.map((part, i) => <Fragment>{i > 0 && <br />}{part}</Fragment>)}</h1>
        <p class="lead net-lead">{L('network.hero.lead')}</p>
        <div class="net-cta">
          <a class="btn btn--primary" href={peopleHref}>{L('common.meetTeams')} <svg class="icon" aria-hidden="true"><use href="#i-arrow"></use></svg></a>
        </div>
      </div>
    </div>
  </header>

  <StatsBar stats={stats} />

  <!-- Core component starts inside the first screen: map + filter + list + detail -->
  <section class="section section--ice section--compact" id="network-explorer">
    <div class="container">
      <NetworkExplorer countries={countries} lang={lang} regions={regions} peopleHref={peopleHref} contactHref={contactHref} />
    </div>
  </section>

  <!-- Below the map: three collaboration notes + one participation entry. No country/member long list. -->
  <section class="section" id="collaboration">
    <div class="container">
      <SectionHeader kicker={L('network.role.kicker')} title={L('network.role.title')} />
      <div class="grid grid--3">
        {roles.map((r) => (
          <article class="card card--flat card--soft">
            <div class="card-body">
              <span class="feature-icon"><svg class="icon" aria-hidden="true"><use href={`#i-${r.icon}`}></use></svg></span>
              <h3>{r.title}</h3>
              <p>{r.body}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="net-join">
        <p class="lead">{L('network.map.note')}</p>
        <a class="btn btn--primary" href={peopleHref}>{L('common.meetTeams')} <svg class="icon" aria-hidden="true"><use href="#i-arrow"></use></svg></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .net-head{padding:44px 0 26px;background:linear-gradient(125deg,#f3faff,#fff 72%)}
  .net-head-inner{display:block}
  .net-title{font-size:clamp(2.6rem,5vw,4.15rem);margin:6px 0 14px;max-width:16ch}
  .net-lead{max-width:720px}
  .net-cta{margin-top:18px}
  .net-join{display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;margin-top:34px;padding-top:26px;border-top:1px solid var(--border,#dce8f0)}
  .net-join .lead{margin:0}
  @media(max-width:600px){
    .net-head{padding:30px 0 20px}
    .net-join{flex-direction:column;align-items:flex-start}
  }
</style>
