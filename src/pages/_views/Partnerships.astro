---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { t, type Lang } from '../../i18n/ui';
import { SITE, localizePath } from '../../config/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (k: string) => t(lang, k);
const partnerEmail = SITE.partnershipEmail ?? 'partner@singaporeyouth.com';
const contactPath = localizePath(lang, 'contact');

const directions = [
  { title: L('partnerships.d1.title'), body: L('partnerships.d1.body'), cta: L('impact.area1.cta'), area: 'exchange' },
  { title: L('partnerships.d2.title'), body: L('partnerships.d2.body'), cta: L('cta.discussResourceCollaboration'), area: 'ai-infrastructure' },
  { title: L('partnerships.d3.title'), body: L('partnerships.d3.body'), cta: L('cta.proposeJointInitiative'), area: 'research' },
  { title: L('partnerships.d4.title'), body: L('partnerships.d4.body'), cta: L('cta.discussCommunityCollaboration'), area: 'community' },
];
const steps = [
  { title: L('partnerships.step1.title'), body: L('partnerships.step1.body') },
  { title: L('partnerships.step2.title'), body: L('partnerships.step2.body') },
  { title: L('partnerships.step3.title'), body: L('partnerships.step3.body') },
];
---

<BaseLayout lang={lang} pageId="partnerships" title={L('seo.partnerships.title')} description={L('seo.partnerships.desc')}>
  <!-- 首屏：紧凑文字 + 独立合作场景图（非合影，不与 About 共用） -->
  <Hero lang={lang} compact eyebrow={L('partnerships.hero.eyebrow')} titleHtml={L('partnerships.hero.title')} lead={L('partnerships.hero.lead')} image="/assets/hero-partnership.jpg" primary={{ label: L('cta.discussPartnership'), href: `${contactPath}?topic=partnership` }} secondary={{ label: L('cta.exploreOurAiAgenda'), href: localizePath(lang, 'ai') }} />

  <!-- 区块1：Where We Can Collaborate（引导句 + 4 方向卡，带 area 参数） -->
  <section class="section" aria-labelledby="partnerships-areas-title">
    <div class="container">
      <SectionHeader title={L('partnerships.grid.title')} lead={L('partnerships.grid.lead')} id="partnerships-areas-title" />
      <div class="card-grid">
        {directions.map((d) => (
          <article class="card"><div class="card-body">
            <h3>{d.title}</h3>
            <p>{d.body}</p>
            <a class="link-arrow" href={`${contactPath}?topic=partnership&area=${d.area}`}>{d.cta} <svg class="icon"><use href="#i-arrow"></use></svg></a>
          </div></article>
        ))}
      </div>
    </div>
  </section>

  <!-- 区块2：Start with a Shared Goal（引导句 + 三步流程） -->
  <section class="section section--ice" aria-labelledby="partnerships-steps-title">
    <div class="container">
      <SectionHeader title={L('partnerships.how.title')} lead={L('partnerships.how.lead')} id="partnerships-steps-title" />
      <div class="card-grid">
        {steps.map((s) => (
          <article class="card"><div class="card-body">
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div></article>
        ))}
      </div>
    </div>
  </section>

  <!-- 区块3：Have a Partnership in Mind?（partner@ 主渠道 + 询价按钮） -->
  <section class="section section--compact" aria-labelledby="partnerships-email-title">
    <div class="container">
      <SectionHeader title={L('partnerships.email.title')} lead={L('partnerships.email.lead')} id="partnerships-email-title" />
      <div class="card-grid">
        <article class="card"><div class="card-body">
          <h3>{L('partnerships.email.label')}</h3>
          <p><a href={`mailto:${partnerEmail}`}>{partnerEmail}</a></p>
          <a class="link-arrow" href={`${contactPath}?topic=partnership`}>{L('partnerships.email.cta')} <svg class="icon"><use href="#i-arrow"></use></svg></a>
        </div></article>
      </div>
    </div>
  </section>
</BaseLayout>
