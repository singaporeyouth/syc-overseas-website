---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import StatsBar from '../../components/StatsBar.astro';
import DualFeature from '../../components/DualFeature.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { t, pick, type Lang } from '../../i18n/ui';
import { pageHref } from '../../config/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (k: string) => t(lang, k);
const [countries, metrics] = await Promise.all([
  getCollection('countries'), getCollection('metrics'),
]);
const mv = (id: string) => metrics.find((m) => m.data.id === id)?.data.display ?? '';
const panel = [
  { value: mv('countries') || '36', label: L('home.stat.countries') },
  { value: mv('reach') || '4.3M+', label: L('home.hero.reach'), note: L('home.hero.reachNote') },
];
const stats = metrics.map((m) => ({
  display: m.data.display,
  label: pick(m.data, 'label', lang),
  icon: m.data.icon,
}));

// Concise "overview + entrance" cards: one line of context, one clear entry point.
// All copy reuses existing i18n keys so all six languages stay in sync.
const exploreCards = [
  { kicker: L('about.mission.kicker'), title: L('nav.about'), lead: L('footer.about'), href: pageHref(lang, 'about'), img: '/assets/community-group.jpg' },
  { kicker: L('home.country.kicker'), title: L('nav.network'), lead: L('home.country.lead'), href: pageHref(lang, 'network'), img: '/assets/city-1.jpg' },
  { kicker: L('home.partners.kicker'), title: L('nav.partnerships'), lead: L('home.partners.lead'), href: pageHref(lang, 'partnerships'), img: '/assets/hero-partnership.jpg' },
  { kicker: L('home.people.kicker'), title: L('nav.people'), lead: L('home.people.lead'), href: pageHref(lang, 'people'), img: '/assets/person-3.jpg' },
  { kicker: L('home.work.kicker'), title: L('nav.work'), lead: L('home.work.lead'), href: pageHref(lang, 'impact'), img: '/assets/workshop.jpg' },
  { kicker: L('home.eco.kicker'), title: L('nav.ai'), lead: L('home.eco.lead'), href: pageHref(lang, 'ai'), img: '/assets/ai-chip.jpg' },
];
---

<BaseLayout lang={lang} pageId="index" title={L('seo.index.title')} description={L('seo.index.desc')} showCta={true}>
  <Hero
    lang={lang}
    eyebrow={L('home.hero.eyebrow')}
    titleHtml={`<span class="grad">${L('home.hero.title1')}</span> <br />${L('home.hero.title2')}`}
    lead={L('home.hero.lead')}
    image="/assets/hero-people.jpg"
    primary={{ label: L('common.exploreNetwork'), href: pageHref(lang, 'network') }}
    secondary={{ label: L('home.hero.cta2'), href: pageHref(lang, 'partnerships') }}
    panel={panel}
    panelTitle1={L('home.hero.panelTitle1')}
    panelTitle2={L('home.hero.panelTitle2')}
  />
  <StatsBar stats={stats} />

  <section class="section">
    <div class="container"><DualFeature lang={lang} countries={countries.map((c) => c.data)} /></div>
  </section>

  <section class="section section--ice">
    <div class="container">
      <SectionHeader kicker={L('home.hero.eyebrow')} title={L('common.searchTitle')} />
      <div class="card-grid">
        {exploreCards.map((c) => (
          <a class="card card--image" href={c.href}>
            <div class="card-media">
              <img src={c.img} alt="" loading="lazy" />
              <span class="card-tag">{c.kicker}</span>
            </div>
            <div class="card-body">
              <h3>{c.title}</h3>
              <p>{c.lead}</p>
              <span class="link-arrow">{L('common.learnMore')} <svg class="icon"><use href="#i-arrow"></use></svg></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
