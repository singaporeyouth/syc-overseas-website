---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { t, type Lang } from '../../i18n/ui';
import { pageHref } from '../../config/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (k: string) => t(lang, k);

const aiNativePoints = [
  { body: L('about.knowledge.body'), icon: 'globe' },
  { body: L('about.connection.body'), icon: 'compass' },
  { body: L('about.collaboration.body'), icon: 'handshake' },
];
const principles = [L('about.principle1'), L('about.principle2'), L('about.principle3')];
---

<BaseLayout lang={lang} pageId="about" title={L('seo.about.title')} description={L('seo.about.desc')}>
  <!-- 首屏：文字主导 + 独立青年 AI 交流场景图（非合影，不与 Partnerships 共用） -->
  <Hero lang={lang} compact eyebrow={L('about.hero.eyebrow')} titleHtml={L('about.hero.title')} lead={L('about.hero.lead')} image="/assets/hero-ai-youth.jpg" primary={{ label: L('cta.exploreOurAiAgenda'), href: pageHref(lang, 'ai') }} />

  <!-- 区块1：Our Purpose -->
  <section class="section" aria-labelledby="about-purpose-title">
    <div class="container narrow">
      <SectionHeader title={L('about.purpose.title')} id="about-purpose-title" />
      <p class="lead">{L('about.purpose.body')}</p>
    </div>
  </section>

  <!-- 区块2：What AI-Native Means to Us（正文 + Knowledge / Connection / Collaboration 三条） -->
  <section class="section section--ice" aria-labelledby="about-ainative-title">
    <div class="container">
      <SectionHeader title={L('about.ainative.title')} lead={L('about.ainative.body')} id="about-ainative-title" />
      <div class="card-grid">
        {aiNativePoints.map((p) => (
          <article class="card"><div class="card-body">
            <span class="feature-icon"><svg class="icon"><use href={`#i-${p.icon}`}></use></svg></span>
            <p>{p.body}</p>
          </div></article>
        ))}
      </div>
    </div>
  </section>

  <!-- 区块3：A Global Outlook. Local Connections. -->
  <section class="section" aria-labelledby="about-global-title">
    <div class="container">
      <SectionHeader title={L('about.global.title')} lead={L('about.global.body')} id="about-global-title" />
      <p><a class="link-arrow" href={pageHref(lang, 'people')}>{L('common.meetTeams')} <svg class="icon"><use href="#i-arrow"></use></svg></a></p>
    </div>
  </section>

  <!-- 区块4：The Principles Behind Our Work（三条原则） -->
  <section class="section section--ice" aria-labelledby="about-principles-title">
    <div class="container">
      <SectionHeader title={L('about.principles.title')} id="about-principles-title" />
      <div class="card-grid">
        {principles.map((p) => (
          <article class="card"><div class="card-body"><p>{p}</p></div></article>
        ))}
      </div>
    </div>
  </section>

  <!-- 区块5：Collaboration Across the Ecosystem -->
  <section class="section section--compact" aria-labelledby="about-ecosystem-title">
    <div class="container">
      <SectionHeader title={L('about.ecosystem.title')} lead={L('about.ecosystem.body')} id="about-ecosystem-title" />
      <p><a class="link-arrow" href={pageHref(lang, 'partnerships')}>{L('cta.explorePartnershipPossibilities')} <svg class="icon"><use href="#i-arrow"></use></svg></a></p>
    </div>
  </section>
</BaseLayout>
