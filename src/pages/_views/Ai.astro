---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { t, pick, type Lang } from '../../i18n/ui';
import { pageHref } from '../../config/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (k: string) => t(lang, k);
const contactHref = pageHref(lang, 'contact');
const platforms = (await getCollection('platforms')).map((p) => p.data);

// Stable anchors + contact areas — shared by the relationship map and the detail cards.
const anchors = ['infrastructure', 'talent', 'research', 'enterprise', 'exchange', 'community'];
const areas = ['ai-infrastructure', 'ai-learning', 'research', 'entrepreneurship', 'exchange', 'community'];
const dirCtaKeys = [
  'cta.discussResourceCollaboration',
  'cta.proposeLearningCollaboration',
  'cta.proposeResearchCollaboration',
  'cta.discussFounderInitiative',
  'cta.proposeExchange',
  'cta.discussRegionalInitiative',
];
const directions = anchors.map((anchor, i) => ({
  no: String(i + 1).padStart(2, '0'),
  title: L(`ai.direction${i + 1}.title`),
  mission: L(`ai.direction${i + 1}.mission`),
  forms: L(`ai.direction${i + 1}.forms`),
  who: L(`ai.direction${i + 1}.who`),
  cta: L(dirCtaKeys[i]),
  anchor,
  href: `${contactHref}?topic=partnership&area=${areas[i]}`,
}));

// Three principles, each explained once and mapped to two directions.
const frameworkGroups = [
  { icon: 'layers', title: L('home.vision.access.title'), body: L('home.vision.access.body'),
    linked: [{ label: L('ai.direction1.title'), anchor: anchors[0] }, { label: L('ai.direction2.title'), anchor: anchors[1] }] },
  { icon: 'lightbulb', title: L('home.vision.create.title'), body: L('home.vision.create.body'),
    linked: [{ label: L('ai.direction3.title'), anchor: anchors[2] }, { label: L('ai.direction4.title'), anchor: anchors[3] }] },
  { icon: 'globe', title: L('home.vision.connect.title'), body: L('home.vision.connect.body'),
    linked: [{ label: L('ai.direction5.title'), anchor: anchors[4] }, { label: L('ai.direction6.title'), anchor: anchors[5] }] },
];

const paths = [
  { icon: 'people', title: L('ai.path1.title'), body: L('ai.path1.body'), cta: L('cta.expressInterest'), href: `${contactHref}?topic=youth-participation` },
  { icon: 'building', title: L('ai.path2.title'), body: L('ai.path2.body'), cta: L('cta.proposeCollaboration'), href: `${contactHref}?topic=partnership` },
  { icon: 'pin', title: L('ai.path3.title'), body: L('ai.path3.body'), cta: L('cta.shareLocalChallenge'), href: `${contactHref}?topic=partnership&area=community` },
];
---

<BaseLayout lang={lang} pageId="ai" title={L('seo.ai.title')} description={L('seo.ai.desc')}>

  <!-- 1. 愿景首屏：文字直接可见；右侧为青年居中、六方向环绕的静态关系图 -->
  <section class="ai-hero">
    <div class="container ai-hero-grid">
      <div class="ai-hero-copy">
        <div class="eyebrow"><svg class="icon"><use href="#i-spark"></use></svg> {L('ai.hero.eyebrow')}</div>
        <h1>{L('ai.hero.title')}</h1>
        <p class="lead">{L('ai.hero.lead')}</p>
        <div class="actions">
          <a class="btn btn--primary" href="#focus-areas">{L('cta.exploreSixDirections')} <svg class="icon"><use href="#i-arrow"></use></svg></a>
          <a class="btn btn--outline" href={`${contactHref}?topic=partnership&area=ai-lab`}>{L('cta.proposeCollaboration')} <svg class="icon"><use href="#i-arrow"></use></svg></a>
        </div>
      </div>

      <div class="ai-hero-visual">
        <div class="ai-map" role="group" aria-label={L('ai.os.kicker')}>
          <svg class="ai-map-lines" viewBox="0 0 480 480" aria-hidden="true">
            <g fill="none" stroke="#24A6B5" stroke-width="1.6" opacity=".7">
              <line x1="240" y1="240" x2="240" y2="58" />
              <line x1="240" y1="240" x2="398" y2="146" />
              <line x1="240" y1="240" x2="398" y2="334" />
              <line x1="240" y1="240" x2="240" y2="422" />
              <line x1="240" y1="240" x2="82" y2="334" />
              <line x1="240" y1="240" x2="82" y2="146" />
            </g>
            <circle cx="240" cy="240" r="196" fill="none" stroke="#1769C2" stroke-width="1" stroke-dasharray="4 10" opacity=".35" />
          </svg>
          <div class="ai-map-core">
            <svg viewBox="0 0 120 80" aria-hidden="true">
              <g fill="#1769C2"><circle cx="38" cy="24" r="9" /><circle cx="82" cy="24" r="9" /><circle cx="60" cy="20" r="10" /></g>
              <g fill="#12324D">
                <path d="M22 62 q16 -16 32 0Z" /><path d="M66 62 q16 -16 32 0Z" /><path d="M42 66 q18 -18 36 0Z" />
              </g>
              <path d="M60 6 l2.6 5.8 5.8 2.6 -5.8 2.6 -2.6 5.8 -2.6 -5.8 -5.8 -2.6 5.8 -2.6Z" fill="#24A6B5" />
            </svg>
            <span>{L('ai.principle1.title')}</span>
          </div>
          {directions.map((d, i) => (
            <a class={`ai-node n${i + 1}`} href={`#${d.anchor}`} aria-label={d.title}>
              <span class="ai-node-no">{d.no}</span>
              <span class="ai-node-label">{d.title}</span>
            </a>
          ))}
        </div>
        <ol class="ai-map-list">
          {directions.map((d) => (
            <li><a href={`#${d.anchor}`}><span class="ai-node-no">{d.no}</span> {d.title}</a></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 2. Framework：解释 AI-native 组织方法，三原则各对应两方向（只解释一次） -->
  <section class="section" aria-labelledby="ai-framework-title">
    <div class="container">
      <SectionHeader kicker={L('ai.os.kicker')} title={L('ai.os.title')} lead={L('ai.os.body')} id="ai-framework-title" />
      <div class="ai-framework">
        {frameworkGroups.map((g) => (
          <div class="framework-item">
            <span class="feature-icon"><svg class="icon"><use href={`#i-${g.icon}`}></use></svg></span>
            <h3>{g.title}</h3>
            <p>{g.body}</p>
            <div class="framework-links">
              {g.linked.map((l) => (
                <a class="framework-link" href={`#${l.anchor}`}>{l.label} <svg class="icon"><use href="#i-arrow"></use></svg></a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. 六方向详情：2.10 完整文案 + Ways to Collaborate + 带 area 的合作入口 -->
  <section class="section section--ice" id="focus-areas" aria-labelledby="ai-directions-title">
    <div class="container">
      <SectionHeader kicker={L('ai.directions.kicker')} title={L('ai.directions.title')} lead={L('ai.directions.lead')} id="ai-directions-title" />
      <div class="ai-dir-grid">
        {directions.map((d) => (
          <article class="card ai-dir-card" id={d.anchor}>
            <div class="card-body">
              <div class="ai-dir-head"><span class="ai-dir-no">{d.no}</span><h3>{d.title}</h3></div>
              <p class="ai-dir-mission">{d.mission}</p>
              <div class="ai-dir-block">
                <span class="ai-dir-label">{L('ai.direction.formsLabel')}</span>
                <p>{d.forms}</p>
              </div>
              <div class="ai-dir-block">
                <span class="ai-dir-label">{L('ai.direction.whoLabel')}</span>
                <p>{d.who}</p>
              </div>
              <a class="btn btn--outline ai-dir-btn" href={d.href}>{d.cta} <svg class="icon"><use href="#i-arrow"></use></svg></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. 按身份参与：三类真实按钮带 topic 参数进入 /contact/ -->
  <section class="section" aria-labelledby="ai-paths-title">
    <div class="container">
      <SectionHeader kicker={L('ai.paths.kicker')} title={L('ai.paths.title')} lead={L('ai.paths.lead')} id="ai-paths-title" />
      <div class="card-grid ai-path-grid">
        {paths.map((p) => (
          <article class="card"><div class="card-body">
            <span class="feature-icon"><svg class="icon"><use href={`#i-${p.icon}`}></use></svg></span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
            <a class="btn btn--primary ai-path-btn" href={p.href}>{p.cta} <svg class="icon"><use href="#i-arrow"></use></svg></a>
          </div></article>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Selected Initiatives：与 Our Work 共用同一份 platforms 数据与真实外链 -->
  <section class="section section--compact section--white" aria-labelledby="ai-initiatives-title">
    <div class="container">
      <SectionHeader kicker={L('ai.initiatives.kicker')} title={L('ai.initiatives.title')} lead={L('ai.initiatives.lead')} id="ai-initiatives-title" />
      <div class="ai-plat-grid">
        {platforms.map((p) => (
          <article class="card ai-plat-card"><div class="card-body">
            <span class="feature-icon"><svg class="icon"><use href={`#i-${p.icon}`}></use></svg></span>
            <h3>{p.name}</h3>
            <p>{pick(p, 'description', lang)}</p>
            <a class="link-arrow" href={p.url} target="_blank" rel="noopener noreferrer" aria-label={`${L('impact.platform.explore')} ${p.name} (external)`}>
              {L('impact.platform.explore')} <svg class="icon"><use href="#i-arrow"></use></svg>
            </a>
          </div></article>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. 最终邀请 -->
  <section class="section ai-invite" aria-labelledby="ai-invite-title">
    <div class="container">
      <div class="ai-invite-inner">
        <div class="kicker">{L('ai.invite.kicker')}</div>
        <h2 id="ai-invite-title">{L('ai.invite.title')}</h2>
        <p>{L('ai.invite.lead')}</p>
        <div class="ai-invite-actions">
          <a class="btn btn--primary" href={`${contactHref}?topic=partnership`}>{L('ai.invite.emailBtn')} <svg class="icon"><use href="#i-arrow"></use></svg></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* 1. Hero + static relationship map */
  .ai-hero{position:relative;background:linear-gradient(120deg,#fbfdff 0%,#eef6fb 58%,#e9f2fa 100%);border-bottom:1px solid var(--line2)}
  .ai-hero-grid{display:grid;grid-template-columns:54fr 46fr;gap:32px;align-items:center;min-height:590px;padding-block:52px}
  .ai-hero-copy h1{font-size:clamp(2.1rem,4.4vw,4rem);line-height:1.1;max-width:14em;margin-bottom:18px}
  .ai-hero-copy .lead{max-width:40em}
  .ai-hero-visual{display:grid;place-items:center;min-height:460px}
  .ai-map{position:relative;width:100%;max-width:480px;aspect-ratio:1/1}
  .ai-map-lines{position:absolute;inset:0;width:100%;height:100%}
  .ai-map-core{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:128px;height:128px;border-radius:50%;
    background:#F5F8FB;border:2px solid #24A6B5;box-shadow:0 10px 28px rgba(18,50,77,.16);display:flex;flex-direction:column;
    align-items:center;justify-content:center;text-align:center;padding:8px}
  .ai-map-core svg{width:74px;height:50px}
  .ai-map-core span{font-size:.7rem;font-weight:800;color:var(--navy);line-height:1.15}
  .ai-node{position:absolute;display:flex;flex-direction:column;gap:3px;align-items:center;justify-content:center;
    width:156px;min-height:62px;padding:8px 10px;text-align:center;text-decoration:none;color:var(--ink);
    background:#fff;border:1px solid var(--line2);border-radius:12px;box-shadow:0 6px 16px rgba(16,43,76,.08);
    transition:transform .18s,border-color .18s,box-shadow .18s}
  .ai-node:hover,.ai-node:focus-visible{transform:translateY(-2px);border-color:var(--accent);box-shadow:0 12px 26px rgba(16,43,76,.16);outline:none}
  .ai-node-no{font:800 11px/1 var(--font);color:var(--accent2);letter-spacing:.1em}
  .ai-node-label{font-size:.74rem;font-weight:700;line-height:1.25}
  .ai-node.n1{top:2%;left:50%;transform:translateX(-50%)}
  .ai-node.n2{top:19%;right:0}
  .ai-node.n3{bottom:19%;right:0}
  .ai-node.n4{bottom:2%;left:50%;transform:translateX(-50%)}
  .ai-node.n5{bottom:19%;left:0}
  .ai-node.n6{top:19%;left:0}
  .ai-node.n1:hover,.ai-node.n1:focus-visible,.ai-node.n4:hover,.ai-node.n4:focus-visible{transform:translateX(-50%) translateY(-2px)}
  .ai-map-list{display:none;list-style:none;margin:0;padding:0;counter-reset:n}
  .ai-map-list li{margin-bottom:10px}
  .ai-map-list a{display:flex;align-items:center;gap:12px;padding:14px 16px;text-decoration:none;color:var(--ink);
    background:#fff;border:1px solid var(--line2);border-radius:12px;font-weight:700}

  /* 2. Framework */
  .ai-framework{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin-top:26px}
  .framework-item{padding:24px;border:1px solid var(--line2);border-radius:16px;background:#fff}
  .framework-item h3{margin:14px 0 8px}
  .framework-item p{color:#55677e;margin:0 0 16px}
  .framework-links{display:flex;flex-direction:column;gap:8px}
  .framework-link{display:inline-flex;align-items:center;gap:6px;font-size:.88rem;font-weight:700;color:var(--accent-ink);text-decoration:none}
  .framework-link:hover{text-decoration:underline}
  .framework-link .icon{width:14px;height:14px}

  /* 3. Six directions */
  .ai-dir-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin-top:24px}
  .ai-dir-card{scroll-margin-top:90px}
  .ai-dir-head{display:flex;align-items:baseline;gap:12px;margin-bottom:12px}
  .ai-dir-no{font:800 13px/1 var(--font);color:var(--accent2);letter-spacing:.1em}
  .ai-dir-head h3{margin:0}
  .ai-dir-mission{color:#243746;margin:0 0 18px}
  .ai-dir-block{margin:0 0 14px;padding-left:12px;border-left:3px solid rgba(36,166,181,.4)}
  .ai-dir-label{display:block;font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:var(--accent-ink);margin-bottom:4px}
  .ai-dir-block p{margin:0;color:#55677e;font-size:.94rem}
  .ai-dir-btn{margin-top:4px}

  /* 4. Identity paths */
  .ai-path-grid .card-body{display:flex;flex-direction:column;align-items:flex-start}
  .ai-path-grid h3{margin:14px 0 8px}
  .ai-path-grid p{color:#55677e;margin:0 0 18px}
  .ai-path-btn{margin-top:auto}

  /* 5. Platforms */
  .ai-plat-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:24px}
  .ai-plat-card .card-body{display:flex;flex-direction:column;align-items:flex-start}
  .ai-plat-card h3{margin:14px 0 8px}
  .ai-plat-card p{color:#55677e;margin:0 0 16px}
  .ai-plat-card .link-arrow{margin-top:auto}

  /* 6. Invite */
  .ai-invite-inner{max-width:820px;margin:0 auto;text-align:center}
  .ai-invite-inner h2{margin:12px 0}
  .ai-invite-inner p{color:#55677e}
  .ai-invite-actions{margin-top:22px}

  @media (max-width:900px){
    .ai-hero-grid{grid-template-columns:1fr;min-height:0;padding-block:38px 24px;gap:24px}
    .ai-hero-copy h1{font-size:clamp(2.1rem,7vw,2.6rem);max-width:none}
    .ai-hero-visual{min-height:0}
    .ai-map{display:none}
    .ai-map-list{display:block}
    .ai-framework{grid-template-columns:1fr}
    .ai-dir-grid{grid-template-columns:1fr}
    .ai-path-grid{grid-template-columns:1fr}
    .ai-plat-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  }
  @media (max-width:520px){
    .ai-plat-grid{grid-template-columns:1fr}
  }
</style>
